!output/.gitkeep

# Modelos de voz (pesados, no van al repo)
models/*.onnx
models/*.onnx.json

# Claves / secretos
.env

# Etapas de ingesta y redaccion
data/noticias.db
runs/*
!runs/*/
runs/*/*
!runs/*/candidatas.md
!runs/barrido_acumulado.md

# Comparaciones pipeline vs. claude.ai manual (ver COMPARACION_METODOS.md):
# se versionan los guiones y la libreta de resultados, no el video/audio pesado
comparaciones/*/*/output/
